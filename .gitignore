backup/
*.sql.gz
*.tar.gz

# WordPress core — lo provee la imagen docker wordpress:latest
# Solo archivos del ROOT (con / delante), no toca wp-content/themes ni plugins
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
