# WordPress runtime
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backup*/
wp-content/aiowps_backups/
wp-content/debug.log
wp-content/*.sql

# Plugins de terceros — se reinstalan, NO se versionan (191MB)
# Solo se versionan los propios cuerpolibre-*
wp-content/plugins/*
!wp-content/plugins/cuerpolibre-setup/
!wp-content/plugins/cuerpolibre-masonry-gallery/

# Themes — solo el propio
wp-content/themes/*
!wp-content/themes/cuerpolibre/

# Logs y temporales
*.log
.git.old-2026-10-16/
test.php
.kogniterm/
.kilocode/
.gemini_interpreter_history
wp-cli.phar

